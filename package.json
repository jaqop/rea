{
  "name": "rea-narrative",
  "version": "0.1.1",
  "description": "Evidence-centered reverse engineering of books and novels with local CLI and MCP tools.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaqop/rea.git"
  },
  "homepage": "https://github.com/jaqop/rea#readme",
  "bugs": {
    "url": "https://github.com/jaqop/rea/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "rea-narrative": "narrative/cli.mjs"
  },
  "files": [
    "narrative/*.mjs",
    "!narrative/*.test.mjs",
    "narrative/skills",
    "docs/narrative-guide.md",
    "docs/NARRATIVE-ARCHITECTURE.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test narrative/*.test.mjs",
    "start": "node narrative/cli.mjs",
    "mcp": "node narrative/cli.mjs mcp",
    "check": "node --check narrative/core.mjs && node --check narrative/contracts.mjs && node --check narrative/store.mjs && node --check narrative/tools.mjs && node --check narrative/mcp.mjs && node --check narrative/cli.mjs",
    "demo": "node narrative/demo.mjs"
  },
  "keywords": [
    "novels",
    "books",
    "narratology",
    "reverse-engineering",
    "evidence",
    "mcp",
    "arabic"
  ]
}
